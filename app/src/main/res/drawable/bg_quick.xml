<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/accent_dim" android:endColor="@color/tile_b" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/tile_a" android:endColor="@color/tile_b" />
            <stroke android:width="1dp" android:color="@color/edge" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
