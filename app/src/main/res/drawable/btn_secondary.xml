<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/text_faint" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dim" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="#1E4452" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
