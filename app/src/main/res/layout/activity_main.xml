<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_root">
  <com.jarvis.control.HudBackgroundView android:layout_width="match_parent" android:layout_height="match_parent" />
  <View android:id="@+id/scanLine" android:layout_width="match_parent" android:layout_height="90dp" android:background="@drawable/scan_glow" />
  <LinearLayout android:id="@+id/appColumn" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout android:id="@+id/pagesFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:id="@+id/homeColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="0dp" android:layout_marginEnd="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J.A.R.V.I.S" android:textColor="@color/accent" android:textSize="28sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.22" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTROL LINK  //  MOBILE NODE" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginTop="2dp" />
              </LinearLayout>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/heroBadge" android:text="● OFFLINE" android:textColor="@color/warning" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_chip" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
            </LinearLayout>
            <com.jarvis.control.ReactorView android:id="@+id/reactorView" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
              <TextView android:id="@+id/chipServer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="● SERVER" android:textColor="@color/text_dim" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_chip" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
              <TextView android:id="@+id/chipLaptop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="● LAPTOP" android:textColor="@color/text_dim" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_chip" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
              <TextView android:id="@+id/chipAi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="● AI" android:textColor="@color/text_dim" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_chip" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="0dp">
              <LinearLayout android:background="@drawable/bg_tile" android:padding="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LATENCY" android:textColor="@color/text_faint" android:textSize="9sp" android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/statLatency" android:text="—" android:textColor="@color/accent" android:textSize="17sp" android:textStyle="bold" android:fontFamily="monospace" />
              </LinearLayout>
              <LinearLayout android:background="@drawable/bg_tile" android:padding="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAPTOP" android:textColor="@color/text_faint" android:textSize="9sp" android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/statLaptop" android:text="—" android:textColor="@color/accent" android:textSize="17sp" android:textStyle="bold" android:fontFamily="monospace" />
              </LinearLayout>
              <LinearLayout android:background="@drawable/bg_tile" android:padding="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATTERY" android:textColor="@color/text_faint" android:textSize="9sp" android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/statBattery" android:text="—" android:textColor="@color/accent" android:textSize="17sp" android:textStyle="bold" android:fontFamily="monospace" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
      </ScrollView>
      <ScrollView android:id="@+id/pageDeck" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/deckColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DECK" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAPTOP CONTROL  //  TAP TO FIRE" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginTop="2dp" />
          </LinearLayout>
        </LinearLayout>
      </ScrollView>
      <ScrollView android:id="@+id/pageLink" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LINK" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISCOVERY  //  PAIRING" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginTop="2dp" />
          </LinearLayout>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 // LINK" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
              <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/line_glow" android:layout_marginStart="10dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTO-DISCOVERY" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/healthLabel" android:text="● Not connected" android:textColor="@color/text_dim" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/connectCodeLabel" android:text="" android:textColor="@color/accent" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginBottom="6dp" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/connectStatusLabel" android:text="Tap the button: the phone finds your laptop, you approve on the laptop. No typing." android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/findLaptopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="FIND MY LAPTOP" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/bg_root" android:background="@drawable/btn_primary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <Button android:id="@+id/openRemoteButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="OPEN LAPTOP REMOTE" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/bg_root" android:background="@drawable/btn_primary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <Button android:id="@+id/unpairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="UNPAIR" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/danger" android:background="@drawable/btn_danger" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <CheckBox android:id="@+id/bootStartCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start Jarvis automatically when the phone boots" android:textColor="@color/text_primary" android:textSize="13sp" android:buttonTint="@color/accent" android:layout_marginBottom="4dp" />
          </com.jarvis.control.HudCard>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02 // PAIR WITH CODE" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
              <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/line_glow" android:layout_marginStart="10dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MANUAL" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fallback: on the laptop tap Pair Phone, then type the code it shows (like 192.168.1.5 482913). This fills every IP and token on both sides." android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginBottom="12dp" />
            <EditText android:id="@+id/pairCodeField" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:hint="192.168.1.5 482913" android:inputType="text" android:singleLine="true" android:fontFamily="monospace" android:textColor="@color/text_primary" android:textColorHint="@color/text_faint" android:textSize="16sp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/pairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="PAIR" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/bg_root" android:background="@drawable/btn_primary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/pairStatusLabel" android:text="● Not paired yet" android:textColor="@color/text_dim" android:textSize="12sp" android:fontFamily="monospace" />
          </com.jarvis.control.HudCard>
        </LinearLayout>
      </ScrollView>
      <ScrollView android:id="@+id/pageCore" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/coreColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORE" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI  //  SERVER  //  SCREEN" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginTop="2dp" />
          </LinearLayout>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03 // AI CORE" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
              <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/line_glow" android:layout_marginStart="10dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OLLAMA" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="10dp" />
            </LinearLayout>
            <CheckBox android:id="@+id/termuxAutoStartCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start the AI in Termux when I tap Start" android:textColor="@color/text_primary" android:textSize="13sp" android:buttonTint="@color/accent" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Command run inside Termux" android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/termuxCommandField" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:singleLine="true" android:fontFamily="monospace" android:textColor="@color/text_primary" android:textColorHint="@color/text_faint" android:textSize="12sp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/startAiButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="START AI NOW" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/text_primary" android:background="@drawable/btn_secondary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/aiStatusLabel" android:text="● Needs one-time setup in Termux (command below)" android:textColor="@color/text_dim" android:textSize="12sp" android:fontFamily="monospace" />
          </com.jarvis.control.HudCard>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04 // CONTROL SERVER" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
              <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/line_glow" android:layout_marginStart="10dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":8765" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lets your laptop send commands to this phone (battery, flashlight, vibrate, notify, etc.)" android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginBottom="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
              <Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="START" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/bg_root" android:background="@drawable/btn_primary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginEnd="6dp" />
              <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="STOP" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/danger" android:background="@drawable/btn_danger" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginStart="6dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/statusLabel" android:text="● Not started" android:textColor="@color/text_dim" android:textSize="13sp" android:fontFamily="monospace" />
          </com.jarvis.control.HudCard>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05 // SCREEN LINK" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
              <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/line_glow" android:layout_marginStart="10dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIRROR" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shows this phone's screen on the laptop. Start the server first, tap the button below and accept Android's prompt, then open Phone Screen in Jarvis on the laptop." android:textColor="@color/text_dim" android:textSize="12sp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/shareScreenButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:text="START SHARING SCREEN" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="@color/text_primary" android:background="@drawable/btn_secondary" app:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/screenStatusLabel" android:text="● Not sharing" android:textColor="@color/text_dim" android:textSize="12sp" android:fontFamily="monospace" />
          </com.jarvis.control.HudCard>
        </LinearLayout>
      </ScrollView>
      <ScrollView android:id="@+id/pageSetup" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/setupColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETUP" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE  //  UPLINK  //  THEME" android:textColor="@color/text_faint" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_marginTop="2dp" />
          </LinearLayout>
          <com.jarvis.control.HudCard android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
              <View android:layout_width="3dp" android:layout_height="16dp" android:background="@color/accent" android:layout_marginEnd="8dp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06 // THIS DEVICE" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" />
