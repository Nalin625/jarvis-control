<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS CONTROL"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Companion app \u2014 bridges this phone to your Jarvis desktop"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Card: Pair with laptop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAIR WITH LAPTOP"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On the laptop tap Pair Phone, then type the code it shows (like 192.168.1.5 482913). This fills every IP and token on both sides."
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/pairCodeField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="192.168.1.5 482913"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Pair"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bg_root"
            android:background="@drawable/btn_primary"
            android:elevation="0dp" />

        <TextView
            android:id="@+id/pairStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF Not paired yet"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- Card: AI server in Termux -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI SERVER (TERMUX)"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="10dp" />

        <CheckBox
            android:id="@+id/termuxAutoStartCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start the AI in Termux when I tap Start"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:buttonTint="@color/accent"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Command run inside Termux"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/termuxCommandField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/startAiButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Start AI now"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="@drawable/btn_secondary"
            android:elevation="0dp" />

        <TextView
            android:id="@+id/aiStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF Needs one-time setup in Termux (command below)"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:text="mkdir -p ~/.termux &amp;&amp; echo 'allow-external-apps=true' >> ~/.termux/termux.properties &amp;&amp; termux-reload-settings"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Card: Screen projection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREEN PROJECTION"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shows this phone's screen on the laptop. Start the server above first, tap the button below and accept Android's prompt, then open Phone Screen in Jarvis on the laptop."
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/shareScreenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Start sharing screen"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bg_root"
            android:background="@drawable/btn_primary"
            android:elevation="0dp" />

        <TextView
            android:id="@+id/screenStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF Not sharing"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- Card: This device -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIS DEVICE"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/ipLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This phone's IP: ..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token (enter this same value on your laptop's /mobile page)"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/tokenField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/saveTokenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Save Token"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="@drawable/btn_secondary"
            android:elevation="0dp" />
    </LinearLayout>

    <!-- Card: Server controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL SERVER"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lets your laptop send commands to this phone (battery, flashlight, vibrate, notify, etc.)"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minHeight="0dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="Start"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/bg_root"
                android:background="@drawable/btn_primary"
                android:elevation="0dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_secondary"
                android:elevation="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF Not started"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Divider label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PHONE \u2192 LAPTOP"
        android:textColor="@color/text_faint"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp" />

    <!-- Card: Notification forwarding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE NOTIFICATIONS ON JARVIS"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laptop IP"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/laptopIpField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="192.168.1.5"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/laptopPortField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="8899"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Token (from laptop Settings \u2192 Remote access)"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/laptopTokenField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/saveLaptopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Save Laptop Connection"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bg_root"
            android:background="@drawable/btn_primary"
            android:elevation="0dp"
            android:layout_marginBottom="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_dim"
            android:layout_marginBottom="18dp" />

        <CheckBox
            android:id="@+id/notifForwardCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forward notifications to Jarvis"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:buttonTint="@color/accent"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/grantNotifAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Grant Notification Access"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_secondary"
            android:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/notifAccessStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF Checking notification access..."
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Needs both: notification access granted above, and the checkbox enabled. Your notifications are forwarded as plain text \u2014 anything sensitive (OTPs, previews) will show up on your laptop too."
            android:textColor="@color/text_faint"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
