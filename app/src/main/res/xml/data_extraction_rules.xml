<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve all unrelated app data; keep local call history on this device only. -->
        <exclude domain="file" path="calls.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="calls.json" />
    </device-transfer>
</data-extraction-rules>
